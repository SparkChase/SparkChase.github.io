{
  "headers": [
    {
      "source": "/vendor/:asset(.*\\.[0-9a-f]{12}\\.(?:js|css))",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/assets/:asset(rikka-(?:desktop|mobile|avatar|favicon)\\.[0-9a-f]{12}\\.(?:webp|png))",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ]
}
